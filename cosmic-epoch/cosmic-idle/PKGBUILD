pkgname=cosmic-idle-git
pkgver=r34.f682e19
pkgrel=1
pkgdesc='cosmic-idle'
arch=('x86_64')
url='https://github.com/pop-os/cosmic-idle.git'
license=('GPLv3')
depends=()
makedepends=('cargo' 'just' 'git' 'cmake')
provides=('cosmic-idle')
conflicts=('cosmic-idle')
source=('git+https://github.com/pop-os/cosmic-idle.git'
)
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/cosmic-idle"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd $srcdir/cosmic-idle
    cargo build --release
}

package() {
  cd $srcdir/cosmic-idle
  just rootdir=$pkgdir install
  #make DESTDIR="$pkgdir" prefix="/usr" install
}
