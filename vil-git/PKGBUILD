# Maintainer: Mitchel Stewart <quackdoctech@gmail.com>

pkgname=vil-git
pkgver=v0.2.alpha.r64.g4c02e34
pkgrel=1
pkgdesc='Vulkan Layer for Live Introspection & Debugging. Allows to view all vulkan state live inside your application.'
arch=('x86_64')
url='https://github.com/nyorain/vil'
license=('GPL-3.0')
makedepends=('git' 'cargo')
depends=('libx11')
optdepends=()
provides=('vil')
conflicts=()
source=("git+https://github.com/nyorain/vil")
sha256sums=('SKIP')

pkgver() {
  cd vil
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

#prepare() {
#}

build() {
  cd vil
  mkdir build
  arch-meson build -Dwerror=false -Dimgio:werror=false
  ninja -C build
}

package() {
  cd vil
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
